// Cloudflare Worker for Battle Royale Chess. For now it only serves the static
// solo build (packages/app/dist); the multiplayer lobby server joins in milestone 4.
// Everything here runs on Cloudflare's free plan.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chessroyale",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "packages/app/dist",
    "not_found_handling": "single-page-application"
  }
}
