// Cloudflare Worker for Battle Royale Chess: serves the app (packages/app/dist) and
// the lobby server (packages/server): one Durable Object per lobby, over WebSockets.
// Everything here runs on Cloudflare's free plan; the chess engine runs in browsers.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chessroyale",
  "main": "packages/server/src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "packages/app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "LOBBIES", "class_name": "Lobby" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby"] }],
  "observability": { "enabled": true }
}
