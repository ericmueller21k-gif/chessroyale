// Cloudflare Worker for HunChess: serves the app (packages/app/dist) and
// the lobby server (packages/server): one Durable Object per lobby, over WebSockets.
// The chess engine runs in browsers; the engine server (engine/Dockerfile: native Stockfish in a Container)
// re-checks the close calls that decide cuts. The sign-in secrets GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET and
// RESEND_API_KEY live in the account's Secrets Store (bound below; values never here).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chessroyale",
  // The account (not a secret: it is in every dashboard address). Wrangler needs it to name the engine server's pinned
  // image below; without it, `wrangler dev` (the e2e suite) would ask Cloudflare who you are, which needs a login.
  "account_id": "86dbf3bbeb8ae6e99afcc62ea1c80492",
  "main": "packages/server/src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "packages/app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin/fairplay", "/admin/fairplay/*", "/admin/ops", "/admin/ops/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "LOBBIES", "class_name": "Lobby" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" },
      { "name": "ENGINE", "class_name": "EngineServer" },
      // The live line and presence in memory (live-hub.ts): one object, so D1 isn't written on every request.
      { "name": "LIVE", "class_name": "LiveHub" },
      // Squads: one object per lobby, one per party (squads-do.ts).
      { "name": "SQUADS", "class_name": "SquadsLobby" },
      { "name": "PARTIES", "class_name": "SquadsParty" },
      // Ranked 1 v 1: one object per game (duel-do.ts).
      { "name": "DUELS", "class_name": "DuelGame" }
    ]
  },
  // The engine server: one vCPU (Stockfish is single-threaded here), asleep after 3 idle minutes. Its image is the one
  // built from engine/Dockerfile and pushed by the Oct 26, 17:20 UTC deploy, pinned by digest, so a deploy needs no
  // Docker (Workers Builds stopped being able to start it that evening). To change the engine server: DEPLOY.md.
  "containers": [{ "class_name": "EngineServer", "image": "registry.cloudflare.com/86dbf3bbeb8ae6e99afcc62ea1c80492/chessroyale-engineserver@sha256:7ebd716c0837096245ddb783fc8713c5aace7e7ae9b41715aef83dd5b464e3d0", "instance_type": "standard-2", "max_instances": 2 }],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Lobby"] },
    { "tag": "v2", "new_sqlite_classes": ["Matchmaker"] },
    { "tag": "v3", "new_sqlite_classes": ["EngineServer"] },
    { "tag": "v4", "new_sqlite_classes": ["LiveHub"] },
    { "tag": "v5", "new_sqlite_classes": ["SquadsLobby", "SquadsParty"] },
    { "tag": "v6", "new_sqlite_classes": ["DuelGame"] }
  ],
  // Accounts, profiles and match results (tables are created by the Worker on first use: see accounts.ts).
  "d1_databases": [{ "binding": "DB", "database_name": "hunchess", "database_id": "103097fd-f61b-4296-8b89-bd967ac33142" }],
  "secrets_store_secrets": [
    { "binding": "GOOGLE_CLIENT_ID", "store_id": "c4aab92a84ec4217acd83a530a799d80", "secret_name": "GOOGLE_CLIENT_ID" },
    { "binding": "GOOGLE_CLIENT_SECRET", "store_id": "c4aab92a84ec4217acd83a530a799d80", "secret_name": "GOOGLE_CLIENT_SECRET" },
    { "binding": "RESEND_API_KEY", "store_id": "c4aab92a84ec4217acd83a530a799d80", "secret_name": "RESEND_API_KEY" }
  ],
  // The game's addresses (Cloudflare sets up DNS and certificates on deploy). hunchess.com was added in the dashboard.
  "routes": [
    { "pattern": "hunchess.com", "custom_domain": true },
    { "pattern": "www.hunchess.com", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  // Cloudflare Access, for the health view's scripts (packages/server/src/access.ts: npm run ops:report): the Zero Trust
  // team and the Access application whose service token they send. Both public (the login page shows them); no secret.
  // At launch, when Access leaves the rest of the site, ACCESS_AUD becomes the health path's own application's.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "odd-wildflower-a76c.cloudflareaccess.com",
    "ACCESS_AUD": "647483892d23ca09bcddd71ba8e6c8b40a04f627ebfa4282c6504b0778ae30dd"
  },
  // Fair play's deep re-check of flagged players' moves (packages/server/src/fairplay-deep.ts), and old errors and
  // player reports deleted (problems.ts).
  "triggers": { "crons": ["*/15 * * * *"] },
  // Keep variables set in the dashboard when a deploy runs (otherwise each deploy would wipe plain-text ones).
  "keep_vars": true,
  "env": {
    // Staging, for load tests only (never load-test production): its own Worker (chessroyale-staging on workers.dev),
    // Durable Objects and D1 database; no engine server, no sign-in (guests play online), the per-address rate
    // limit off for a test from one machine, the test switches on (a load test's own queue, ?pool=).
    // scripts/load/staging.sh creates it, deploys, and tears it down (DEPLOY.md, "Load testing"). The database id is
    // filled in by that script.
    "staging": {
      "routes": [],
      "workers_dev": true,
      "durable_objects": {
        "bindings": [
          { "name": "LOBBIES", "class_name": "Lobby" },
          { "name": "MATCHMAKER", "class_name": "Matchmaker" },
          { "name": "LIVE", "class_name": "LiveHub" },
          { "name": "SQUADS", "class_name": "SquadsLobby" },
          { "name": "PARTIES", "class_name": "SquadsParty" },
          { "name": "DUELS", "class_name": "DuelGame" }
        ]
      },
      "d1_databases": [{ "binding": "DB", "database_name": "hunchess-staging", "database_id": "STAGING_D1_ID" }],
      "vars": { "ENGINE_OFF": "1", "LOAD_TEST": "1", "TEST_SWITCHES": "1" },
      "observability": { "enabled": true }
    }
  }
}
