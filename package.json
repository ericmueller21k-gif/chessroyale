{
  "name": "chessroyale",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "npm run build -w @chessroyale/app",
    "dev": "npm run dev -w @chessroyale/app",
    "e2e": "playwright test",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/chess --noEmit && tsc -p packages/sim --noEmit && tsc -p packages/app --noEmit && tsc -p packages/server --noEmit",
    "replays:bots": "tsx packages/sim/scripts/bot-replays.ts",
    "simulate": "tsx packages/sim/scripts/simulate.ts",
    "sim:squads": "tsx packages/sim/scripts/squads-sim.ts",
    "preview:items": "node scripts/preview-items.mjs",
    "preview:characters": "tsx scripts/preview-characters.ts",
    "frames:boss": "node scripts/frames-boss-move.mjs",
    "frames:character": "node scripts/frames-boss-character.mjs",
    "frames:wip": "node scripts/frames-wip.mjs",
    "frames:god-king": "node scripts/frames-god-king.mjs",
    "frames:powers": "node scripts/frames-boss-powers.mjs",
    "frames:hollow": "node scripts/frames-hollow.mjs",
    "frames:bigboy": "node scripts/frames-bigboy.mjs",
    "frames:queue": "node scripts/frames-queue-pop.mjs",
    "frames:flash": "node scripts/frames-flash.mjs",
    "frames:chat": "node scripts/frames-chat-move.mjs",
    "frames:vote": "node scripts/frames-vote.mjs",
    "frames:close": "node scripts/frames-lobby-close.mjs",
    "frames:matchmaking": "node scripts/frames-matchmaking.mjs",
    "frames:home": "node scripts/frames-home-queue.mjs",
    "frames:lobbychat": "node scripts/frames-lobby-chat.mjs",
    "perf:boss": "node scripts/perf-boss.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "wrangler": "^4.147.0",
    "ws": "^8.21.0"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "stockfish": "^19.0.0"
  }
}
